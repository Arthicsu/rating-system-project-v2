# BACKEND

# django
# default debug true
DEBUG=True
SECRET_KEY="django-insecure-symbols"
CLIENT_URL="http://localhost:3000"
API_SCHEMA_URL="http://localhost:8000"

USE_GUNICORN=false
DJANGO_LOG_LEVEL=ADDLEVEL

# Gunicorn
GUNICORN_WORKERS=2
GUNICORN_TIMEOUT=120

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# SeaweedFS
SEAWEEDFS_ACCESS_KEY=generate_random_key
SEAWEEDFS_SECRET_KEY=generate_random_key
SEAWEEDFS_BUCKET_NAME=bucket_name
# use internal URL for docker
SEAWEEDFS_ENDPOINT_URL=http://seaweedfs:8333
# use external URL for public access
SEAWEEDFS_PUBLIC_URL=http://localhost:8888

# postgres
POSTGRES_DB=db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DB_HOST=db
DB_PORT=5432

# FRONTEND
NEXT_PUBLIC_API_URL="http://localhost:8000"