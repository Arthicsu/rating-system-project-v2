# syntax=docker/dockerfile:1

# Dev

ARG NODE_VERSION=26.12.1
ARG PNPM_VERSION=10.34.9
ARG COREPACK_VERSION=0.36.0

FROM node:${NODE_VERSION}-alpine AS base

ARG PNPM_VERSION
ARG COREPACK_VERSION

WORKDIR /app

# С Node 25 corepack не входит в образ - ставим закреплённую версию из npm.
RUN npm install -g corepack@${COREPACK_VERSION} \
    && corepack enable && corepack prepare pnpm@${PNPM_VERSION} --activate \
    && [ "$(pnpm --version)" = "${PNPM_VERSION}" ]

# Дальше всё от штатного пользователя node, не от root.
# Права выдаём на пустом каталоге и ставим зависимости уже 
# от node: chown -R после установки продублировал бы весь слой node_modules
# и раздул образ вдвое
RUN chown node:node /app
USER node

FROM base AS deps

COPY --chown=node:node package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./
RUN pnpm install --frozen-lockfile

FROM deps AS dev

COPY --chown=node:node . .

# Каталог под volume next_cache должен существовать и принадлежать node до
# старта: docker наследует владельца из образа при инициализации volume'а
RUN mkdir -p /app/.next

EXPOSE 3000

# Webpack dev server
CMD ["pnpm", "exec", "next", "dev", "--turbopack", "-H", "0.0.0.0", "-p", "3000"]
